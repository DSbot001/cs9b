# For every final slot, find the maximum in the unsorted portion and swap it into that slot.



'''Selection Sort'''
def selectionSort(aList):
    # fillslot is the final position
    # where we will place the largest element
    for i in range(len(aList) - 1, 0, -1):

        # Assume the first element is the maximum
        positionOfMax = 0

        # Search for the true maximum
        # inside the unsorted portion
        for j in range(1, i + 1):
            if aList[j] > aList[positionOfMax]:
                positionOfMax = j

        # Swap the maximum element
        # into its correct final position
        temp = aList[i]
        aList[i] = aList[positionOfMax]
        aList[positionOfMax] = temp



a_list = [4, 7, 2, 9, 0]
selectionSort(a_list)
print(a_list)




def test_selectionSort():
	list1 = [1,2,3,4,5,6]
	list2 = [2,2,2,2,2,2]
	list3 = []
	list4 = [6,7,5,3,1]
	selectionSort(list1)
	assert list1 == [1,2,3,4,5,6]
	selectionSort(list2)
	assert list2 == [2,2,2,2,2,2]
	selectionSort(list3)
	assert list3 == []
	selectionSort(list4)
	assert list4 == [1,3,5,6,7]


test_selectionSort()



# Similar to Bubble Sort, we have to make n-1 comparisons during the first iteration through the list
# Then n-2 comparisons during the 2nd iteration, etc.
# If we count the number of comparisons in this algorithm, we have
# n-1 + n-2 + … + 2 + 1 = n(n+1)/2
# O(n2)
# Note: we only do one swap operation per iteration unlike Bubble Sort






'''Insertion Sort'''
def insertionSort(aList):
	for index in range(1,len(aList)):

		currentvalue = aList[index]
		position = index

		# shift elements over by one
		while position > 0 and aList[position-1] > currentvalue:
			aList[position] = aList[position-1]
			position = position-1

		# insert element in appropriate place
		aList[position] = currentvalue


def test_insertionSort():
	list1 = [1,2,3,4,5,6]
	list2 = [2,2,2,2,2,2]
	list3 = []
	list4 = [6,7,5,3,1]
	insertionSort(list1)
	assert list1 == [1,2,3,4,5,6]
	insertionSort(list2)
	assert list2 == [2,2,2,2,2,2]
	insertionSort(list3)
	assert list3 == []
	insertionSort(list4)
	assert list4 == [1,3,5,6,7]

test_insertionSort()
# If the element immediately to the left is greater than currentvalue, shift it right. Continue moving left until currentvalue reaches the position where the element on the left is smaller or equal. Then insert currentvalue there.



'''Insertion Sort Analysis'''
# When we check where to insert an element, we do up to 1 swap on the first iteration in order to make room for the element to be inserted in the sorted left portion of the list
# Then we do up to two swaps on the second iteration
# Then up to three swaps on the third iteration, etc.
# So we get: 1 + 2 + … + n-2 + n-1 swaps
# O(n2)
# Let’s also look at the BEST case scenario (the list is already sorted)
# Here, we still go through n elements, but no swaps occur because each position is in the correct place
# So in the best case scenario, we have O(n)